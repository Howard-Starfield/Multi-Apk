<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_switcher_pill"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/handle"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:contentDescription="@string/switcher_handle">

            <View
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_switcher_grip" />
        </FrameLayout>

        <TextView
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/switcher_back"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="112dp"
            android:layout_height="54dp"
            android:overScrollMode="never" />

        <FrameLayout
            android:id="@+id/macros"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/macros_button"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_macro" />

            <View
                android:id="@+id/macrosDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="14dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- The window is wider and taller than the visible tab so the handle is easy to hit. -->
    <FrameLayout
        android:id="@+id/tab"
        android:layout_width="36dp"
        android:layout_height="80dp"
        android:contentDescription="@string/switcher_handle"
        android:visibility="gone">

        <View
            android:id="@+id/grip"
            android:layout_width="14dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical" />
    </FrameLayout>
</FrameLayout>
