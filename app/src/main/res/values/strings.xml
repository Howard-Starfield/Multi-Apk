    <string name="guide_battery_title">Ignore battery optimisation</string>
    <string name="guide_battery_text">Stops the system from pausing CloneLab in the background.</string>
    <string name="guide_overlay_title">Display over other apps</string>
    <string name="guide_overlay_text">Needed to restart clones automatically. Without it you get a notification to tap instead.</string>
