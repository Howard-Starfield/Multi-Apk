<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".CloneLabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CloneLab">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.add.AddCloneActivity"
            android:exported="false"
            android:label="@string/add_clone_title" />
        <activity
            android:name=".ui.group.CloneGroupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.detail.CloneDetailActivity"
            android:exported="false"
            android:label="@string/detail_title" />
        <activity
            android:name=".ui.keepalive.KeepAliveGuideActivity"
            android:exported="false"
            android:label="@string/guide_title" />

        <activity
            android:name=".location.LocationActivity"
            android:exported="false"
            android:label="@string/location_title" />
        <activity
            android:name=".device.DeviceProfileActivity"
            android:exported="false"
            android:label="@string/device_title" />

        <!-- Hands a downloaded update APK to the system installer. Not exported; its own authority, not the engine's. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false" />

        <receiver
            android:name=".keepalive.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".keepalive.RunningActionsReceiver"
            android:exported="false" />

        <receiver
            android:name=".keepalive.ExitReceiver"
            android:exported="false" />

        <activity
            android:name=".shortcut.ShortcutTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CloneLab.Trampoline" />
    </application>
</manifest>
